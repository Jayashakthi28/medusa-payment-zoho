# Zoho Payments — India (default)
# live or sandbox
ZOHO_PAYMENTS_ENVIRONMENT=live
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_PAYMENTS_SIGNING_KEY=
ZOHO_PAYMENTS_API_KEY=

# Optional
ZOHO_PAYMENTS_REGION=in
ZOHO_PAYMENTS_CHECKOUT_MODE=widget
ZOHO_PAYMENTS_SUCCESS_URL=https://storefront.example.com/checkout/success
ZOHO_PAYMENTS_FAILURE_URL=https://storefront.example.com/checkout?payment=failed
ZOHO_PAYMENTS_BUSINESS_NAME=
ZOHO_PAYMENTS_LIVE_MODE=false

# Used only by standalone scripts
ZOHO_PAYMENTS_REDIRECT_URI=http://localhost:53682/callback
# Optional: write the refresh token directly to an ignored env file
ZOHO_PAYMENTS_ENV_FILE=.env.sandbox
# Set to true to prevent the OAuth helper from opening a browser
ZOHO_PAYMENTS_NO_BROWSER=false
