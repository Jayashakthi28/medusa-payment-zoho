{
  "name": "medusa-payment-zoho",
  "version": "1.0.0",
  "description": "Zoho Payments payment provider for Medusa v2 — India-first, with embedded Checkout Widget, hosted checkout, signed webhooks, refunds, and a browser checkout helper.",
  "author": "Jayashakthi Vishnu",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./providers/zoho": {
      "import": {
        "types": "./dist/providers/zoho/index.d.ts",
        "default": "./dist/providers/zoho/index.js"
      },
      "require": {
        "types": "./dist/providers/zoho/index.d.cts",
        "default": "./dist/providers/zoho/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/patch-cjs-provider.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:check": "npm pack --dry-run && publint && attw --pack . --profile node16",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm pack:check && pnpm verify:package",
    "prepublishOnly": "pnpm check"
  },
  "keywords": [
    "medusa",
    "medusajs",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-payment",
    "medusa-plugin-integration",
    "payment",
    "payments",
    "payment-provider",
    "zoho",
    "zoho-payments",
    "zohopay",
    "india",
    "inr",
    "upi",
    "cards",
    "ach",
    "checkout",
    "ecommerce"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jayashakthi28/medusa-payment-zoho.git"
  },
  "homepage": "https://github.com/Jayashakthi28/medusa-payment-zoho#readme",
  "bugs": {
    "url": "https://github.com/Jayashakthi28/medusa-payment-zoho/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@medusajs/framework": ">=2.17.2 <3.0.0",
    "@medusajs/medusa": ">=2.17.2 <3.0.0",
    "@medusajs/types": ">=2.17.2 <3.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@medusajs/framework": "2.22.0",
    "@medusajs/medusa": "2.22.0",
    "@medusajs/types": "2.22.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
